# Benchmark output: summary.json, runs.json, table.md, charts, and the
# content-addressed response cache. All of it regenerates from the corpus, and
# committing it means a binary diff on every run.
results/

# The corpus itself. Built from LongMemEval, which is 278 MB of raw JSON
# upstream -- fetch and convert it instead of checking it in:
#   python scripts/build_longmemeval.py
tasks/longmemeval/

# Same for LoCoMo -- built by scripts/build_locomo.py, which caches the
# 2.8 MB upstream JSON under results/cache/ (already ignored above).
tasks/locomo/
